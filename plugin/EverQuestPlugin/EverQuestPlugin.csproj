<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Loupedeck.EverQuestPlugin</RootNamespace>
    <LangVersion>latest</LangVersion>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>

    <PluginApiDir>C:\Program Files\Logi\LogiPluginService\</PluginApiDir>
    <PluginDir>$(LocalAppData)\Logi\LogiPluginService\Plugins\</PluginDir>

    <BaseOutputPath>$(MSBuildProjectDirectory)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\</BaseIntermediateOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\bin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both assemblies ship with Logi Plugin Service, so they are guaranteed present at
         runtime and must NOT be copied next to the plugin (a duplicate PluginApi makes the
         service refuse to load it). Referencing them from the service folder also keeps the
         versions in lockstep with the host. -->
    <Reference Include="PluginApi">
      <HintPath>$(PluginApiDir)PluginApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing.Common">
      <HintPath>$(PluginApiDir)System.Drawing.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- System.Drawing.Common on .NET 10 surfaces types from these two. -->
    <Reference Include="System.Private.Windows.Core">
      <HintPath>$(PluginApiDir)System.Private.Windows.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Private.Windows.GdiPlus">
      <HintPath>$(PluginApiDir)System.Private.Windows.GdiPlus.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyPackage" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <PackageFiles Include="package\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(OutputPath)..\%(RecursiveDir)" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="echo $(BaseOutputPath)$(Configuration)\ &gt; &quot;$(PluginDir)$(ProjectName).link&quot;&#xD;&#xA;start loupedeck:plugin/EverQuest/reload" />
  </Target>

  <Target Name="PluginClean" AfterTargets="CoreClean">
    <Delete Files="$(PluginDir)$(ProjectName).link" />
    <RemoveDir Directories="$(OutputPath)..\" />
  </Target>

</Project>
